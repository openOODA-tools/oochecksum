// # oochecksum Root System Anchor
//
// Logline: Unified system verification anchor connecting core, render, and IPC subsystems.
//
// Setup: Exports top-level invariant predicates and executes holistic sanity checks.
//
// Beats:
//   1. Verify core types, manifest parser, and digest calculator.
//   2. Verify render status formatters and warning summaries.
//   3. Verify IPC options and MCP protocol handlers.
//   4. Deliver overall system readiness verification.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_entire_system() -> Bool {
    if !verify_core_subsystem() {
        return false;
    }
    if !verify_render_subsystem() {
        return false;
    }
    if !verify_ipc_subsystem() {
        return false;
    }
    return true;
}
