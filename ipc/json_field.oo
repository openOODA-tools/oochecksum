// # JSON Field Extractor and Escaper
//
// Logline: Minimal parser and serializer for JSON strings and numeric fields.
//
// Setup: Decodes incoming MCP requests and encodes outgoing JSON responses.
//
// Beats:
//   1. Escape special characters for valid JSON encoding.
//   2. Extract string field values for given object keys.
//   3. Extract integer field values for given object keys.
//   4. Validate payload structure without external dependencies.

pub fn json_escape(s: String) -> String {
    let mut out: String = "";
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let ch: Int = byte_at(s, i);
        if ch == 34 { out = out + "\\\""; }
        else if ch == 92 { out = out + "\\\\"; }
        else if ch == 10 { out = out + "\\n"; }
        else if ch == 13 { out = out + "\\r"; }
        else if ch == 9 { out = out + "\\t"; }
        else { out = out + str_slice(s, i, i + 1); }
        i = i + 1;
    }
    return out;
}

pub fn extract_json_str(payload: String, key: String) -> String {
    let needle: String = "\"" + key + "\":\"";
    if !str_contains(payload, needle) {
        let space_needle: String = "\"" + key + "\": \"";
        if !str_contains(payload, space_needle) {
            return "";
        }
        let full_len: Int = chars_len(payload);
        let klen: Int = chars_len(space_needle);
        let mut i: Int = 0;
        while i <= full_len - klen {
            if str_slice(payload, i, i + klen) == space_needle {
                let start: Int = i + klen;
                let mut end: Int = start;
                while end < full_len && byte_at(payload, end) != 34 { end = end + 1; }
                return str_slice(payload, start, end);
            }
            i = i + 1;
        }
        return "";
    }
    let full_len: Int = chars_len(payload);
    let klen: Int = chars_len(needle);
    let mut i: Int = 0;
    while i <= full_len - klen {
        if str_slice(payload, i, i + klen) == needle {
            let start: Int = i + klen;
            let mut end: Int = start;
            while end < full_len && byte_at(payload, end) != 34 { end = end + 1; }
            return str_slice(payload, start, end);
        }
        i = i + 1;
    }
    return "";
}

pub fn extract_json_int(payload: String, key: String, default_val: Int) -> Int {
    let val_str: String = extract_json_str(payload, key);
    let n: Int = chars_len(val_str);
    if n == 0 { return default_val; }
    let mut num: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: Int = byte_at(val_str, i);
        if ch >= 48 && ch <= 57 { num = (num * 10) + (ch - 48); }
        i = i + 1;
    }
    return num;
}
